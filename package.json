{
  "name": "aaa-universe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A living, procedurally generated universe — cosmic web to planetary surface — rendered in real time with Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "glslcheck": "node tools/glslcheck.mjs",
    "shadercheck": "node tools/shadercheck.mjs",
    "civcheck": "node tools/civcheck.mjs",
    "check": "npm run typecheck && npm run glslcheck && npm run build && npm run civcheck",
    "test": "npm run check && npm run shadercheck",
    "shoot": "node tools/shoot.mjs",
    "perf": "node tools/perf.mjs"
  },
  "dependencies": {
    "postprocessing": "^6.37.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-glsl": "^1.5.1"
  },
  "license": "MIT"
}
