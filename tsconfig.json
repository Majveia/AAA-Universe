{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    // Relative, and with no `baseUrl`: TypeScript 6 removes the option outright
    // and rejects non-relative path targets. Paths are resolved against this
    // file's directory, which is what `baseUrl: "."` meant anyway — so this is
    // the same mapping, spelled in a way that survives the next major.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
